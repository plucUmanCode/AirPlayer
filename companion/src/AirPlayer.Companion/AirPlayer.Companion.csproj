<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AirPlayer.Companion</RootNamespace>
    <AssemblyName>AirPlayer.Companion</AssemblyName>
    <!-- Shared sources must also compile under Unity 6; keep the lowest common language version. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Single source of truth: the same pure-C# core the Unity app consumes as a local package. -->
    <Compile Include="../../../shared/AirPlayer.Core/**/*.cs" LinkBase="Core" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AirPlayer.Companion.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
